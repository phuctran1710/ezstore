# Local development configuration for agents-cli playground / run / eval.
# Copy to .env (git-ignored). In Docker Compose these come from the root .env.

# Model credentials (choose one) — the same ones the quotation agent uses
# A. Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# B. Vertex AI (after `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

AGENT_MODEL=gemini-3.8-flash

# Optional: model for the eval LLM judges. Defaults to AGENT_MODEL.
# JUDGE_MODEL=gemini-3.5-flash-lite

# Order MCP server (docker compose publishes it on localhost:8011)
MCP_URL=http://localhost:8011/mcp

# Quotation agent's A2A endpoint (docker compose publishes it on 127.0.0.1:8081)
QUOTATION_AGENT_URL=http://localhost:8081/a2a/quotation_agent
